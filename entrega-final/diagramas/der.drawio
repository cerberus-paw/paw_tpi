ell><mxCell id="u_canjea_usuario_l0" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="u_canjea_usuario"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="r_le_toca" value="Le_Toca" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="2073.0" y="1455.0" width="104" height="50" as="geometry"/></mxCell><mxCell id="u_le_toca_parte" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="r_le_toca" target="e_parte"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u_le_toca_parte_l0" value="(0,n)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="u_le_toca_parte"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-19" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="u_le_toca_usuario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="r_le_toca" target="e_usuario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2250" y="1480"/><mxPoint x="2250" y="1110"/><mxPoint x="1185.0" y="1110"/></Array></mxGeometry></mxCell><mxCell id="u_le_toca_usuario_l0" value="(0,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="u_le_toca_usuario"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="19" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r_cobra" value="Cobra" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1938.0" y="1615.0" width="104" height="50" as="geometry"/></mxCell><mxCell id="u_cobra_liquidacion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="r_cobra" target="e_liquidacion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="u_cobra_liquidacion_l0" value="(0,n)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="u_cobra_liquidacion"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-19" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="u_cobra_usuario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="r_cobra" target="e_usuario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2270" y="1640"/><mxPoint x="2270" y="1100"/><mxPoint x="1207.5" y="1100"/></Array></mxGeometry></mxCell><mxCell id="u_cobra_usuario_l0" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="u_cobra_usuario"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="19" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="r_reparte" value="Reparte" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="2328.0" y="935.0" width="104" height="50" as="geometry"/></mxCell><mxCell id="u_reparte_reparto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="r_reparte" target="e_reparto"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2380" y="1270"/><mxPoint x="1835" y="1270"/></Array></mxGeometry></mxCell><mxCell id="u_reparte_reparto_l0" value="(0,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="u_reparte_reparto"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="0" y="11" as="offset"/></mxGeometry></mxCell><mxCell id="u_reparte_funcion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="r_reparte" target="e_funcion"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2380" y="650"/><mxPoint x="500" y="650"/></Array></mxGeometry></mxCell><mxCell id="u_reparte_funcion_l0" value="(1,1)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;" vertex="1" connectable="0" parent="u_reparte_funcion"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="0" y="-11" as="offset"/></mxGeometry></mxCell><mxCell id="t_titulo" value="IndieCinema · DER" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t_sub" value="Entidades y relaciones de la base, al 27/11/2026 (versión 1.0.0, tag entrega-final). Cada recuadro es el esquema de un subsistema, con su color. Los atributos, en la página «DER con atributos»." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="-18" width="2000" height="30" as="geometry"/></mxCell><mxCell id="n_conceptual" value="&lt;b&gt;Cómo leer el conceptual&lt;/b&gt;&lt;br&gt;Rectángulo: entidad, con el color de su subsistema. Doble: entidad débil (ROL, CONDUCTA, AVISO y REPARTO_PARTE se identifican con otra).&lt;br&gt;Rombo: relación. Doble: la que identifica a la débil. Con color: se vuelve una tabla de ese subsistema (las N a N, Vota, Marca, Sigue, Sigue_A, Se_Suma y Bloquea).&lt;br&gt;Recuadro alrededor de OBRA, Incluye y FUNCION: agregación, la obra candidata de una función. Vota une esa candidata con el USUARIO que la elige.&lt;br&gt;(min,max) pegado al rombo, sobre la línea de cada entidad: cuántas de esa entidad le corresponden a una de la otra. Una SALA programa (0,n) FUNCION y cada FUNCION es de (1,1) SALA.&lt;br&gt;Punteada: une esquemas distintos. Cada subsistema sólo ve su esquema, así que no hay FOREIGN KEY: lo garantiza la aplicación.&lt;br&gt;No se dibujan las columnas que sólo dicen quién hizo algo (resuelta_por, moderador_id, cargado_por, autor_id, bloqueado_por…): están en las tablas. AVISO cuelga de la sala; se dibuja junto a SUSPENSION, que es lo que avisa.&lt;br&gt;DENUNCIA apunta a una sala, una función, una obra o una calificación según su tipo (objeto_id): no se dibuja una línea a cada una. Tampoco el cupón que usa una RESERVA (reserva.cupon, a CUPON), para no cruzar todo el dibujo: está en las tablas. Tampoco CAMBIO_ESTADO_CUENTA (el historial de suspensiones de cada USUARIO) ni COSTO_SALA (el costo de referencia de una SALA para el reporte de plata)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1760" width="1250" height="210" as="geometry"/></mxCell><mxCell id="n_cambios" value="" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="1760" width="880" height="210" as="geometry"/></mxCell><mxCell id="n_col" value="&lt;b&gt;Colores&lt;/b&gt;: el subsistema dueño de cada entidad y de cada tabla." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1442" y="1768" width="850" height="20" as="geometry"/></mxCell><mxCell id="n_col0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1445" y="1796" width="30" height="18" as="geometry"/></mxCell><mxCell id="n_col0t" value="programación" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1482" y="1795" width="140" height="20" as="geometry"/></mxCell><mxCell id="n_col1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1595" y="1796" width="30" height="18" as="geometry"/></mxCell><mxCell id="n_col1t" value="funciones" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1632" y="1795" width="140" height="20" as="geometry"/></mxCell><mxCell id="n_col2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1720" y="1796" width="30" height="18" as="geometry"/></mxCell><mxCell id="n_col2t" value="cuentas" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1757" y="1795" width="140" height="20" as="geometry"/></mxCell><mxCell id="n_col3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1835" y="1796" width="30" height="18" as="geometry"/></mxCell><mxCell id="n_col3t" value="moderación" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1872" y="1795" width="140" height="20" as="geometry"/></mxCell><mxCell id="n_col4" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1965" y="1796" width="30" height="18" as="geometry"/></mxCell><mxCell id="n_col4t" value="recaudación" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2002" y="1795" width="140" height="20" as="geometry"/></mxCell><mxCell id="n_col5" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="2095" y="1796" width="30" height="18" as="geometry"/></mxCell><mxCell id="n_col5t" value="control_migraciones" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2132" y="1795" width="140" height="20" as="geometry"/></mxCell><mxCell id="n_cam" value="&lt;b&gt;Cambios contra la entrega 4&lt;/b&gt; (tag entrega-4, 09/11)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1442" y="1828" width="850" height="20" as="geometry"/></mxCell><mxCell id="n_cam1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1445" y="1856" width="30" height="18" as="geometry"/></mxCell><mxCell id="n_cam1t" value="Borde grueso: se agregó después: los esquemas moderacion y recaudacion enteros, pedidos, bloqueos, calificaciones, conducta, seguimientos, tokens de cuenta y el historial de estados de cuenta." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1482" y="1850" width="820" height="34" as="geometry"/></mxCell><mxCell id="n_cam2" value="solicitud_sala se mudó de programacion a moderacion (la sala guarda solicitud_id). Columnas nuevas en tablas que ya estaban: reserva (pago con Mercado Pago, reembolso, recordatorio y cupón), obra (estado y motivo de la moderación), funcion (votacion_cierra_en y finalizada_en), sala (solicitud_id), usuario (verificacion_reenviada_en) y acuerdo_fecha (cancelacion_avisada_en). Desde el 18/11: la devolución de la solicitud, la gravedad, foto y sala de la denuncia, la comisión del reparto y el título normalizado del pedido." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1442" y="1888" width="855" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="der-atributos" name="DER con atributos"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t2_titulo" value="IndieCinema · DER con atributos" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="-60" width="1200" height="40" as="geometry"/></mxCell><mxCell id="t2_sub" value="Las tablas de MySQL 8.4 leídas de la base de dev el 27/11/2026 (versión 1.0.0, tag entrega-final). Cada recuadro es el esquema de un subsistema, con su usuario de MySQL." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="-18" width="2400" height="30" as="geometry"/></mxCell><mxCell id="n_restricciones" value="&lt;b&gt;* Restricciones&lt;/b&gt;&lt;br&gt;&lt;b&gt;*&lt;/b&gt; (FK) en rojo: guarda el id de otro esquema y no tiene FOREIGN KEY; lo controla la aplicación, con el id que manda nginx o el que devuelve la API interna.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; usuario: correo único sin distinguir mayúsculas. Contraseña con Argon2id. Borrar el usuario borra sus roles, sesiones, tokens y seguimientos (CASCADE).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; cambio_estado_cuenta: cada suspensión o reactivación de una cuenta, con quién, cuándo y motivo.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; sesion y token_de_cuenta: huella es el SHA-256 de la cookie o del enlace del correo; el token es de un solo uso (usado_en).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; seguimiento: objeto_id es una sala o un organizador según tipo.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; funcion: con fecha_hora una vez programada; cupo &amp;gt; 0 y precio_base ≥ 0 (0 es «a la gorra»).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; voto: uno por usuario y función; la obra tiene que ser candidata de esa función (aplicación).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; obra: entra pendiente y la usa la cartelera recién aprobada por la moderación. Baja lógica en sala y obra (dada_de_baja_en).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; pedido_titulo: abierto → activo al llegar al umbral de adhesiones → tomado, con obra, quién y cuándo (CHECK). Una adhesión por usuario. titulo_normalizado evita pedir dos veces lo mismo.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; bloqueo: uno por sala y usuario, con motivo no vacío.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; reserva: pendiente_pago con vencimiento (CHECK); pago_id y reembolso_id únicos; cupon_en_uso es generada (el cupón, salvo si está cancelada) y única: un cupón sirve para una sola reserva en pie. Que no se pase el cupo lo controla la aplicación con un bloqueo por función.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; calificacion: puntaje de 1 a 5, una por usuario y función. sala_id y organizador_id repiten los de la función para los promedios sin pedírselos a programación.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; conducta: una por reserva; la negativa lleva motivo (CHECK).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; solicitud_sala: una abierta por sala (pendiente_de, generada, única). Resuelta ⇔ con resuelta_en y motivo; la revisión manual, con su motivo, quién y cuándo (CHECK). Devuelta: con motivo, faltantes y vencimiento; si no se reenvía a tiempo, vence.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; documento: uno vigente por tipo y solicitud (tipo_vigente, generada y única: los rechazados no cuentan); vence_en decide la suspensión por vencimiento.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; suspension: una activa por sala y causa (activa_de); la de vencimiento dice qué documento (CHECK). La sala se apaga con la primera y vuelve con la última levantada.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; denuncia: una abierta por usuario y objeto; resuelta ⇔ con acción, y cerrada ⇔ con motivo, quién y cuándo (CHECK). La gravedad sale de la categoría; sala_id es la sala del objeto denunciado.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; revision_requisitos: aprobar exige tildar los cuatro requisitos (CHECK).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; parametro_reparto: sala + dueño + plataforma = 100 y ninguno negativo; uno por fecha de vigencia.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; reparto: uno por función (la tarea no duplica). Primero se descuenta la comisión de Mercado Pago; las partes suman el resto y la de la plataforma no tiene beneficiario (CHECK).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; costo_sala: uno por sala, lo que le cuesta abrir una función; sin cargar, el reporte usa uno de referencia.&lt;br&gt;&lt;b&gt;*&lt;/b&gt; liquidacion: una por beneficiario y mes; transferida ⇔ con fecha (CHECK).&lt;br&gt;&lt;b&gt;*&lt;/b&gt; cupon: porcentaje de 1 a 100. Los puntos no se guardan: asistencias × 10 menos los cupones canjeados." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4150" y="60" width="520" height="760" as="geometry"/></mxCell><mxCell id="n_valores" value="&lt;b&gt;Valores permitidos (ENUM)&lt;/b&gt;&lt;br&gt;&lt;b&gt;usuario.estado&lt;/b&gt;: pendiente, activa, suspendida&lt;br&gt;&lt;b&gt;rol.tipo&lt;/b&gt;: espectador, organizador, moderador, administrador&lt;br&gt;&lt;b&gt;seguimiento.tipo&lt;/b&gt;: sala, organizador · &lt;b&gt;token_de_cuenta.proposito&lt;/b&gt;: verificar, recuperar&lt;br&gt;&lt;b&gt;funcion.estado&lt;/b&gt;: en_votacion_titulos, en_acuerdo_fecha, programada, cancelada, finalizada&lt;br&gt;&lt;b&gt;funcion_obra.estado&lt;/b&gt;: candidata, elegida · &lt;b&gt;obra.tipo&lt;/b&gt;: pelicula, cortometraje&lt;br&gt;&lt;b&gt;obra.origen_copia&lt;/b&gt;: obra_propia, dominio_publico, licencia_adquirida&lt;br&gt;&lt;b&gt;obra.estado&lt;/b&gt;: pendiente, aprobada, rechazada · &lt;b&gt;pedido_titulo.estado&lt;/b&gt;: abierto, activo, tomado&lt;br&gt;&lt;b&gt;reserva.estado&lt;/b&gt; (y los dos de cambio_reserva): pendiente_pago, confirmada, cancelada, asistio, ausente&lt;br&gt;&lt;b&gt;cambio_reserva.autor_rol&lt;/b&gt;: espectador, organizador, administrador, sistema&lt;br&gt;&lt;b&gt;usuario.estado&lt;/b&gt; (y los dos de cambio_estado_cuenta): pendiente, activa, suspendida&lt;br&gt;&lt;b&gt;acuerdo_fecha.estado&lt;/b&gt;: abierto, confirmado, sin_minimo, cancelado&lt;br&gt;&lt;b&gt;solicitud_sala.estado&lt;/b&gt;: pendiente, en_revision_manual, devuelta, aprobada, rechazada, vencida&lt;br&gt;&lt;b&gt;solicitud_sala.devolucion_faltantes&lt;/b&gt; (SET): seguro, habilitacion&lt;br&gt;&lt;b&gt;documento.tipo&lt;/b&gt;: seguro, habilitacion · &lt;b&gt;documento.estado&lt;/b&gt;: pendiente, aceptado, rechazado&lt;br&gt;&lt;b&gt;suspension.causa&lt;/b&gt;: retiro, vencimiento, denuncia&lt;br&gt;&lt;b&gt;revision_obra.resolucion&lt;/b&gt;: aprobada, rechazada&lt;br&gt;&lt;b&gt;revision_requisitos.resolucion&lt;/b&gt;: aprobada, rechazada, en_revision_manual, devuelta&lt;br&gt;&lt;b&gt;denuncia.tipo&lt;/b&gt;: sala, funcion, obra, calificacion · &lt;b&gt;estado&lt;/b&gt;: abierta, desestimada, resuelta&lt;br&gt;&lt;b&gt;denuncia.categoria&lt;/b&gt;: ofensivo, derechos, falsa, seguridad, otro, no_se_hizo, cambio_sin_aviso, instalaciones&lt;br&gt;&lt;b&gt;denuncia.gravedad&lt;/b&gt;: baja, media, alta · &lt;b&gt;accion&lt;/b&gt;: suspender, rechazar, ocultar, tomada&lt;br&gt;&lt;b&gt;reparto_parte.rol&lt;/b&gt;: sala, dueno, plataforma · &lt;b&gt;liquidacion.estado&lt;/b&gt;: pendiente, transferida" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4150" y="860" width="520" height="420" as="geometry"/></mxCell><mxCell id="n_tablas" value="&lt;b&gt;Cómo leer las tablas&lt;/b&gt;&lt;br&gt;Subrayada: clave primaria. En cursiva: admite NULL.&lt;br&gt;FKn y UKn: clave foránea y clave única, numeradas por tabla.&lt;br&gt;En rojo, (FK): guarda el id de otro esquema, sin FOREIGN KEY. Su línea va roja y punteada, salvo las que van al usuario: casi todas las tablas tienen una y taparían el resto.&lt;br&gt;Extremos de las líneas: || uno · o| cero o uno · |&amp;lt; uno o muchos · o&amp;lt; cero o muchos.&lt;br&gt;InnoDB y utf8mb4; los id son CHAR(36) con un UUID que genera la aplicación." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4150" y="1320" width="520" height="180" as="geometry"/></mxCell><mxCell id="t_usuario" value="usuario" style="shape=table;startSize=30;container=1;collapsible=1;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="430" height="264" as="geometry"/></mxCell><mxCell id="f_usuario_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;top=0;left=0;bottom=0;right=0;fillColor=none;" vertex="1" parent="t_usuario"><mxGeometry x="0" y="30" width="430" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_id_k" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;fontStyle=1;" vertex="1" parent="f_usuario_id"><mxGeometry x="0" y="0" width="80" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_id_n" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;fontStyle=4;" vertex="1" parent="f_usuario_id"><mxGeometry x="80" y="0" width="190" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_id_t" value="CHAR(36)" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;" vertex="1" parent="f_usuario_id"><mxGeometry x="270" y="0" width="160" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_nombre" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;top=0;left=0;bottom=0;right=0;fillColor=none;" vertex="1" parent="t_usuario"><mxGeometry x="0" y="56" width="430" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_nombre_k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;fontStyle=1;" vertex="1" parent="f_usuario_nombre"><mxGeometry x="0" y="0" width="80" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_nombre_n" value="nombre" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;" vertex="1" parent="f_usuario_nombre"><mxGeometry x="80" y="0" width="190" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_nombre_t" value="VARCHAR(100)" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;" vertex="1" parent="f_usuario_nombre"><mxGeometry x="270" y="0" width="160" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_correo" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;top=0;left=0;bottom=0;right=0;fillColor=none;" vertex="1" parent="t_usuario"><mxGeometry x="0" y="82" width="430" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_correo_k" value="UK1" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;fontStyle=1;" vertex="1" parent="f_usuario_correo"><mxGeometry x="0" y="0" width="80" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_correo_n" value="correo" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;" vertex="1" parent="f_usuario_correo"><mxGeometry x="80" y="0" width="190" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_correo_t" value="VARCHAR(254)" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;" vertex="1" parent="f_usuario_correo"><mxGeometry x="270" y="0" width="160" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_contrasena_hash" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=12;top=0;left=0;bottom=0;right=0;fillColor=none;" vertex="1" parent="t_usuario"><mxGeometry x="0" y="108" width="430" height="26" as="geometry"/></mxCell><mxCell id="f_usuario_contrasena_hash_k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;overflow=hidden;html=1;whiteSpace=wrap;fontSize=12;top=0;left=0;bottom=0;right=0;fontStyle=1;" vertex="1" parent="f_usuario_contrasena_hash"><mxGeometry x="0" y="0" width="80" height="26" as="geometry"/></mxCell><mxCell id=