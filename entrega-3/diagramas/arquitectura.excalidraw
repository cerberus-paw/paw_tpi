    {
      "id": "81ZHMhRFRiSBBCeJCae8B",
      "type": "text",
      "x": 2702.125,
      "y": 206,
      "width": 274.40000000000003,
      "height": 245,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
